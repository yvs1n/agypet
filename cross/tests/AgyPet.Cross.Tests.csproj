<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AgyPet.Cross.Tests</AssemblyName>
    <RootNamespace>AgyPet.CrossTests</RootNamespace>
    <StartupObject>AgyPet.CrossTests.CrossTests</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AssemblyInfo.cs" Link="Shared\AssemblyInfo.cs" />
    <Compile Include="..\..\src\MascotCore.cs" Link="Shared\MascotCore.cs" />
    <Compile Include="..\..\src\Json.cs" Link="Shared\Json.cs" />
    <Compile Include="..\..\src\PetSettings.cs" Link="Shared\PetSettings.cs" />
    <Compile Include="..\..\src\ActivityMonitor.cs" Link="Shared\ActivityMonitor.cs" />
    <Compile Include="..\..\src\Updater.cs" Link="Shared\Updater.cs" />
    <Compile Include="..\Theme.cs" Link="Cross\Theme.cs" />
    <Compile Include="..\MascotView.cs" Link="Cross\MascotView.cs" />
    <Compile Include="..\PlatformWindowTracker.cs" Link="Cross\PlatformWindowTracker.cs" />
    <Compile Include="..\PetWindow.cs" Link="Cross\PetWindow.cs" />
    <Compile Include="..\TrayMenu.cs" Link="Cross\TrayMenu.cs" />
    <Compile Include="..\FeedbackWindow.cs" Link="Cross\FeedbackWindow.cs" />
    <Compile Include="..\Program.cs" Link="Cross\Program.cs" />
    <Compile Include="CrossTests.cs" />
  </ItemGroup>
</Project>
